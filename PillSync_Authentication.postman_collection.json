		{
			"name": "2. JWT Authentication",
			"item": [
				{
					"name": "Login - Success (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set('accessToken', jsonData.access);",
									"}",
									"if (jsonData.refresh) {",
									"    pm.collectionVariables.set('refreshToken', jsonData.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"Test@12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login", ""]
						}
					}
				},
				{
					"name": "Login - Failure: Incorrect Password (401 Unauthorized)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"WrongPassword@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login", ""]
						}
					}
				},
				{
					"name": "Token Refresh - Success (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set('accessToken', jsonData.access);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/token/refresh/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "token", "refresh", ""]
						}
					}
				},
				{
					"name": "Token Refresh - Failure: Invalid Token (401 Unauthorized)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"invalid_token_sample\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/token/refresh/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "token", "refresh", ""]
						}
					}
				},
				{
					"name": "JWT Logout - Invalidate Refresh Token (200 OK)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "logout", ""]
						}
					}
				}
			]
		},
