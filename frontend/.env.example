# Copy to frontend/.env and fill in your own values. Never commit the real .env.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# never put a private/service-role key here, everything in this file ships to the client.

# Supabase project — Project Settings → API in the Supabase dashboard.
# The anon key is safe for the browser; Row Level Security policies
# (docs/database/schema.sql) are what actually restrict access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_APP_NAME=PillSync

# Used from Milestone 3 onward once the Django/FastAPI service (OCR, refill
# prediction) comes online. Not required to run Milestone 1.
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Cloud Messaging (public web app config) — used from Milestone 2
# for push notifications. Not required to run Milestone 1.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
