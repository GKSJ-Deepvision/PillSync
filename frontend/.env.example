# Copy to frontend/.env and fill in your own values. Never commit the real .env.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# never put a private key here, everything in this file ships to the client.

VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=PillSync

# Firebase Cloud Messaging (public web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
