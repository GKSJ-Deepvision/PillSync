# Copy to backend/.env and fill in your own values. Never commit the real .env.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Development defaults to SQLite; set these for PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=pillsync
POSTGRES_USER=pillsync
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# --- Background jobs ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- OCR / AI ---
TESSERACT_CMD=/usr/bin/tesseract
OPENAI_API_KEY=

# --- Notifications ---
FIREBASE_CREDENTIALS_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@pillsync.local

# --- Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Added in Milestones 3 and 4 (all optional) ---
# OCR: read scans inline (false) or on a Celery worker (true, needs a running worker)
OCR_ASYNC=false
# Scans never added to a medicine list are deleted, image included, after this many days
OCR_RETENTION_DAYS=30
# Largest accepted prescription photo, in bytes (default 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760
# How many days before running out the refill warning starts
REFILL_LEAD_TIME_DAYS=5
# Per-user API rate limit. Raise ONLY on a stack you are load testing.
THROTTLE_USER_RATE=5000/day
# Requests slower than this many milliseconds are logged
SLOW_REQUEST_MS=500
# Email: set SENDGRID_API_KEY (above) or an SMTP host to send real email in production
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
