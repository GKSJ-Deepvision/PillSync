# Copy to backend/.env and fill in your own values. Never commit the real .env.
#
# This branch uses the FastAPI alternative (see backend/README.md), so these
# variables map to config/settings.py, not Django settings.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY="QXR1blVTM6sg4gglsx29rvprLSDjX3139Ds18DQq0GM"
DEBUG=True

# --- Database ---
# Async DSN consumed directly by SQLAlchemy's asyncpg driver.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://pillsync:pillsync@localhost:5432/pillsync
POSTGRES_DB=pillsync
POSTGRES_USER=pillsync
POSTGRES_PASSWORD=pillsync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=False

# --- Auth (used from the accounts app, not required to run this milestone) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# --- Background jobs (used from Milestone 2 onward) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- OCR / AI (used from Milestone 3 onward) ---
TESSERACT_CMD=/usr/bin/tesseract
OPENAI_API_KEY=

# --- Notifications (used from Milestone 2 onward) ---
FIREBASE_CREDENTIALS_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@pillsync.local

# --- Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
