# Copy to backend/.env and fill in your own values. Never commit the real .env.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Development defaults to SQLite; set these for PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=pillsync
POSTGRES_USER=pillsync
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# --- Background jobs ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- OCR / AI ---
TESSERACT_CMD=/usr/bin/tesseract
OPENAI_API_KEY=

# --- Notifications ---
FIREBASE_CREDENTIALS_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@pillsync.local

# --- Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
